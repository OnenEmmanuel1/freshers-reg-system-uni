<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="hfrs-layout">
  <div class="hfrs-main-wrapper">
    <%- include('../partials/sidebar') %>

    <main class="hfrs-content-area">
      <!-- ERS Header Bar: Title on left, Action Buttons on right -->
      <div class="hfrs-page-header">
        <h1 class="hfrs-page-title">Registration History</h1>

        <div class="hfrs-page-actions">
          <a href="/auth/register" class="hfrs-btn hfrs-btn-primary">
            + Register Account
          </a>
          <button type="button" class="hfrs-btn hfrs-btn-outline" onclick="const p=document.getElementById('hfrsFilterCard'); p.style.display=p.style.display==='none'?'block':'none';">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon></svg>
            Filter
          </button>
        </div>
      </div>

      <!-- Filter Controls Panel (ERS Popover Style) -->
      <div id="hfrsFilterCard" class="hfrs-card" style="<%= (filters.search || filters.status || filters.faculty) ? 'display: block;' : 'display: none;' %>">
        <div class="hfrs-card-header mb-3 pb-2">
          <h2 class="hfrs-card-title" style="font-size: 1rem;">Filter Options</h2>
          <a href="/admin/records" class="hfrs-btn hfrs-btn-outline" style="padding: 0.25rem 0.6rem; font-size: 0.75rem;">Reset Filter</a>
        </div>

        <form method="GET" action="/admin/records">
          <div class="row">
            <div class="col-md-4 hfrs-form-group">
              <label for="search" class="hfrs-label">Search Student</label>
              <input type="text" id="search" name="search" class="hfrs-input" placeholder="Name, email, or application number..." value="<%= filters.search %>">
            </div>

            <div class="col-md-4 hfrs-form-group">
              <label for="status" class="hfrs-label">Registration Status</label>
              <select id="status" name="status" class="hfrs-select">
                <option value="">All Statuses</option>
                <option value="draft" <%= filters.status === 'draft' ? 'selected' : '' %>>Draft</option>
                <option value="pending_verification" <%= filters.status === 'pending_verification' ? 'selected' : '' %>>Pending Verification</option>
                <option value="approved" <%= filters.status === 'approved' ? 'selected' : '' %>>Approved</option>
                <option value="rejected" <%= filters.status === 'rejected' ? 'selected' : '' %>>Rejected</option>
              </select>
            </div>

            <div class="col-md-4 hfrs-form-group">
              <label for="faculty" class="hfrs-label">Faculty Filter</label>
              <input type="text" id="faculty" name="faculty" class="hfrs-input" placeholder="e.g. Engineering" value="<%= filters.faculty %>">
            </div>

            <div class="col-12 style-actions" style="text-align: right;">
              <button type="submit" class="hfrs-btn hfrs-btn-primary">Apply Filters</button>
            </div>
          </div>
        </form>
      </div>

      <!-- ERS Style Data Table -->
      <div class="hfrs-card">
        <div class="hfrs-card-header">
          <h2 class="hfrs-card-title">Student Registration Records (<%= records.length %> Found)</h2>
          <a href="/api/reports/csv" class="hfrs-btn hfrs-btn-outline" style="padding: 0.35rem 0.75rem; font-size: 0.8rem;">📥 Export CSV</a>
        </div>

        <div class="hfrs-table-responsive">
          <table class="hfrs-table">
            <thead>
              <tr>
                <th>Order</th>
                <th>App Number</th>
                <th>Student Details</th>
                <th>Faculty & Department</th>
                <th>Payment Status</th>
                <th>Status</th>
                <th style="text-align: right;">Action</th>
              </tr>
            </thead>
            <tbody>
              <% if (records && records.length > 0) { %>
                <% records.forEach((r, index) => { %>
                  <tr>
                    <td style="font-weight: 600; color: var(--hfrs-text-muted);"><%= index + 1 %></td>
                    <td><strong><%= r.application_number %></strong></td>
                    <td>
                      <div style="font-weight: 600; color: #000000;"><%= r.student_name %></div>
                      <small style="color: var(--hfrs-text-muted);"><%= r.student_email %> | <%= r.phone %></small>
                    </td>
                    <td><%= r.faculty %> / <%= r.department %></td>
                    <td>
                      <% if (r.payment_status === 'confirmed') { %>
                        <span class="hfrs-status-text complete">Confirmed</span>
                      <% } else if (r.payment_status === 'pending') { %>
                        <span class="hfrs-status-text pending">Pending</span>
                      <% } else { %>
                        <span class="hfrs-status-text draft">Unpaid</span>
                      <% } %>
                    </td>
                    <td>
                      <% 
                        let bClass = 'hfrs-badge-draft';
                        let statusText = r.registration_status.toUpperCase();
                        if (r.registration_status === 'pending_verification') { bClass = 'hfrs-badge-pending'; statusText = 'PENDING'; }
                        if (r.registration_status === 'approved') { bClass = 'hfrs-badge-approved'; statusText = 'COMPLETE'; }
                        if (r.registration_status === 'rejected') { bClass = 'hfrs-badge-rejected'; statusText = 'REJECTED'; }
                      %>
                      <span class="hfrs-badge <%= bClass %>"><%= statusText %></span>
                    </td>
                    <td style="text-align: right;">
                      <div class="hfrs-row-actions">
                        <a href="/admin/verify/<%= r.registration_id %>" class="hfrs-action-icon-btn" title="Inspect Record">
                          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                        </a>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="7" style="text-align: center; color: var(--hfrs-text-muted); padding: 2.5rem;">
                    No student records match the search filter criteria.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <!-- ERS Pagination Bar Footer -->
        <div class="hfrs-pagination-bar">
          <div>
            <span>Items per page: </span>
            <select style="border: 1px solid var(--hfrs-border-color); border-radius: 4px; padding: 0.15rem 0.4rem; font-size: 0.8rem;">
              <option>15</option>
              <option>25</option>
              <option>50</option>
            </select>
          </div>

          <div class="hfrs-pagination-controls">
            <span>1-<%= records ? records.length : 0 %> of <%= records ? records.length : 0 %></span>
            <a href="#" class="hfrs-pagination-btn" onclick="return false;">&lt;</a>
            <a href="#" class="hfrs-pagination-btn" onclick="return false;">&gt;</a>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>

<%- include('../partials/footer') %>
