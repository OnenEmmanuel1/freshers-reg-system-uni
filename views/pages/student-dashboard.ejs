<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="hfrs-layout">
  <div class="hfrs-main-wrapper">
    <%- include('../partials/sidebar') %>

    <main class="hfrs-content-area">
      <!-- ERS Header Bar: Title on left, Primary Action button on right -->
      <div class="hfrs-page-header">
        <h1 class="hfrs-page-title">Registration History</h1>

        <div class="hfrs-page-actions">
          <a href="/student/registration" class="hfrs-btn hfrs-btn-primary">
            + Continue Registration
          </a>
        </div>
      </div>

      <!-- Single Registration Status Detail Card (Adapting Table Concept for Single Student Entry) -->
      <div class="hfrs-card">
        <div class="hfrs-card-header">
          <h2 class="hfrs-card-title">My Fresher Registration Status</h2>
          <% 
            let statusBadgeClass = 'hfrs-badge-draft';
            let statusLabel = 'DRAFT INCOMPLETE';
            let statusTextClass = 'draft';
            if (registration) {
              if (registration.status === 'pending_verification') { statusBadgeClass = 'hfrs-badge-pending'; statusLabel = 'PENDING VERIFICATION'; statusTextClass = 'pending'; }
              else if (registration.status === 'approved') { statusBadgeClass = 'hfrs-badge-approved'; statusLabel = 'APPROVED / COMPLETE'; statusTextClass = 'approved'; }
              else if (registration.status === 'rejected') { statusBadgeClass = 'hfrs-badge-rejected'; statusLabel = 'REJECTED'; statusTextClass = 'rejected'; }
            }
          %>
          <span id="hfrsLiveStatusBadge" class="hfrs-badge <%= statusBadgeClass %>">
            <span>●</span> <%= statusLabel %>
          </span>
        </div>

        <div class="hfrs-table-responsive mb-3">
          <table class="hfrs-table">
            <thead>
              <tr>
                <th>Order</th>
                <th>Application Number</th>
                <th>Student Name</th>
                <th>Faculty & Department</th>
                <th>Payment Status</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td style="font-weight: 600; color: var(--hfrs-text-muted);">1</td>
                <td><strong><%= profile ? profile.application_number : 'UNI/2026/PENDING' %></strong></td>
                <td>
                  <div style="font-weight: 600; color: #000000;"><%= user.name %></div>
                  <small style="color: var(--hfrs-text-muted);"><%= user.email %></small>
                </td>
                <td><%= profile && profile.faculty ? profile.faculty + ' / ' + profile.department : 'Profile Incomplete' %></td>
                <td>
                  <% if (payment) { %>
                    <span class="hfrs-status-text <%= payment.status === 'confirmed' ? 'complete' : 'pending' %>">
                      <%= payment.status === 'confirmed' ? 'Confirmed' : 'Pending' %>
                    </span>
                  <% } else { %>
                    <span class="hfrs-status-text draft">Unpaid</span>
                  <% } %>
                </td>
                <td>
                  <span class="hfrs-status-text <%= statusTextClass %>"><%= statusLabel %></span>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <% if (registration && registration.status === 'rejected') { %>
          <div class="hfrs-alert hfrs-alert-danger">
            <div>
              <strong>Registration Rejection Notice:</strong><br>
              <%= registration.rejection_reason || 'Your application was rejected due to incomplete or unclear documents.' %><br>
              <em>Please update your profile/documents in the registration wizard and re-submit for verification.</em>
            </div>
          </div>
        <% } %>

        <div style="display: flex; justify-content: space-between; align-items: center; pt-2; border-top: 1px solid var(--hfrs-border-color);">
          <div style="font-size: 0.85rem; color: var(--hfrs-text-muted);">
            Submission Date: <%= registration && registration.submitted_at ? new Date(registration.submitted_at).toLocaleDateString() : 'Not Yet Submitted' %>
          </div>
          <a href="/student/status" class="hfrs-btn hfrs-btn-outline">View Real-Time Tracking Timeline &rarr;</a>
        </div>
      </div>

      <!-- Registration Steps Checklist Cards -->
      <div class="hfrs-card">
        <div class="hfrs-card-header">
          <h2 class="hfrs-card-title">Registration Progress Checklist</h2>
        </div>

        <div class="row">
          <div class="col-md-3 mb-3">
            <div style="padding: 1rem; border: 1px solid var(--hfrs-border-color); border-radius: 8px; background: #ffffff;">
              <div style="font-size: 0.75rem; font-weight: 700; color: var(--hfrs-text-muted);">STEP 1: BIO-DATA</div>
              <div style="font-weight: 700; font-size: 0.95rem; margin: 0.25rem 0;">
                <%= profile && profile.phone ? 'Completed' : 'Pending' %>
              </div>
              <span class="hfrs-badge <%= profile && profile.phone ? 'hfrs-badge-approved' : 'hfrs-badge-pending' %>">
                <%= profile && profile.phone ? 'DONE' : 'ACTION NEEDED' %>
              </span>
            </div>
          </div>

          <div class="col-md-3 mb-3">
            <div style="padding: 1rem; border: 1px solid var(--hfrs-border-color); border-radius: 8px; background: #ffffff;">
              <div style="font-size: 0.75rem; font-weight: 700; color: var(--hfrs-text-muted);">STEP 2: PAYMENT</div>
              <div style="font-weight: 700; font-size: 0.95rem; margin: 0.25rem 0;">
                <%= payment ? (payment.status === 'confirmed' ? 'Confirmed' : 'Pending') : 'Not Paid' %>
              </div>
              <span class="hfrs-badge <%= payment ? (payment.status === 'confirmed' ? 'hfrs-badge-approved' : 'hfrs-badge-pending') : 'hfrs-badge-draft' %>">
                <%= payment ? payment.status.toUpperCase() : 'UNPAID' %>
              </span>
            </div>
          </div>

          <div class="col-md-3 mb-3">
            <div style="padding: 1rem; border: 1px solid var(--hfrs-border-color); border-radius: 8px; background: #ffffff;">
              <div style="font-size: 0.75rem; font-weight: 700; color: var(--hfrs-text-muted);">STEP 3: DOCUMENTS</div>
              <div style="font-weight: 700; font-size: 0.95rem; margin: 0.25rem 0;">
                <%= documents.length %> Uploaded
              </div>
              <span class="hfrs-badge <%= documents.length >= 2 ? 'hfrs-badge-approved' : 'hfrs-badge-pending' %>">
                <%= documents.length >= 2 ? 'READY' : 'UPLOAD NEEDED' %>
              </span>
            </div>
          </div>

          <div class="col-md-3 mb-3">
            <div style="padding: 1rem; border: 1px solid var(--hfrs-border-color); border-radius: 8px; background: #ffffff;">
              <div style="font-size: 0.75rem; font-weight: 700; color: var(--hfrs-text-muted);">STEP 4: SUBMISSION</div>
              <div style="font-weight: 700; font-size: 0.95rem; margin: 0.25rem 0;">
                <%= registration ? registration.status : 'draft' %>
              </div>
              <span class="hfrs-badge <%= statusBadgeClass %>">
                <%= statusLabel %>
              </span>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>

<!-- Student Account Creation & Passport Upload Prompt Modal -->
<% if (!profile || !profile.phone || documents.length < 2 || !payment) { %>
  <div id="hfrsStudentPromptModal" class="hfrs-modal-overlay">
    <div class="hfrs-modal-card">
      <div class="hfrs-modal-header">
        <h3 style="font-size: 1.15rem; font-weight: 700; color: #000000; margin: 0; display: flex; align-items: center; gap: 0.35rem;"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg> Welcome to UNICROSS! Action Required</h3>
        <button class="hfrs-modal-close" onclick="document.getElementById('hfrsStudentPromptModal').style.display='none';">&times;</button>
      </div>
      <div class="hfrs-modal-body">
        <p style="font-size: 0.9rem; color: var(--hfrs-text-primary); margin-bottom: 0.75rem;">
          Hello <strong><%= user.name %></strong>, welcome to UNICROSS UniRegister! Your fresher account has been successfully created.
        </p>
        <div style="background-color: #f1f5f9; padding: 1rem; border-radius: 6px; margin-bottom: 1.25rem; border-left: 4px solid var(--hfrs-blue-primary);">
          <div style="font-weight: 700; font-size: 0.85rem; color: var(--hfrs-blue-primary); margin-bottom: 0.35rem;">REGISTRATION CHECKLIST:</div>
          <ul style="font-size: 0.85rem; color: var(--hfrs-text-secondary); margin-left: 1.25rem; margin-bottom: 0;">
            <li>Fill out your Bio-Data & Academic Details</li>
            <li>Upload your <strong>Passport Photograph</strong> & O-Level Results</li>
            <li>Pay Acceptance & Registration Fee</li>
          </ul>
        </div>
        <div style="text-align: right; display: flex; gap: 0.5rem; justify-content: flex-end;">
          <button class="hfrs-btn hfrs-btn-outline" onclick="document.getElementById('hfrsStudentPromptModal').style.display='none';">Remind Me Later</button>
          <a href="/student/registration?step=1" class="hfrs-btn hfrs-btn-primary">Complete Bio-Data & Upload Photo &rarr;</a>
        </div>
      </div>
    </div>
  </div>
<% } %>

<script src="/js/student.js"></script>
<%- include('../partials/footer') %>
