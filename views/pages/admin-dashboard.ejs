<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="hfrs-layout">
  <div class="hfrs-main-wrapper">
    <%- include('../partials/sidebar') %>

    <main class="hfrs-content-area">
      <!-- ERS Header Bar: Title on left, Action Buttons on right -->
      <div class="hfrs-page-header">
        <h1 class="hfrs-page-title">Registration Queue</h1>

        <div class="hfrs-page-actions">
          <a href="/api/reports/csv" class="hfrs-btn hfrs-btn-primary">
            + Export CSV Report
          </a>
          <a href="/admin/records?status=pending_verification" class="hfrs-btn hfrs-btn-outline">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon></svg>
            Filter Queue
          </a>
        </div>
      </div>

      <!-- Metrics Cards Grid -->
      <div class="hfrs-metric-grid">
        <div class="hfrs-metric-card">
          <div class="hfrs-metric-label">Total Freshers Registered</div>
          <div class="hfrs-metric-value"><%= metrics.totalStudents %></div>
          <div class="hfrs-metric-subtext">Active fresher accounts</div>
        </div>

        <div class="hfrs-metric-card" style="border-left: 4px solid var(--hfrs-accent-amber);">
          <div class="hfrs-metric-label">Pending Verification Queue</div>
          <div class="hfrs-metric-value" style="color: var(--hfrs-accent-amber);"><%= metrics.statusCounts.pending_verification || 0 %></div>
          <div class="hfrs-metric-subtext">Requires admin review</div>
        </div>

        <div class="hfrs-metric-card" style="border-left: 4px solid var(--hfrs-accent-green);">
          <div class="hfrs-metric-label">Approved Applications</div>
          <div class="hfrs-metric-value" style="color: var(--hfrs-accent-green);"><%= metrics.statusCounts.approved || 0 %></div>
          <div class="hfrs-metric-subtext">Enrolled freshers</div>
        </div>

        <div class="hfrs-metric-card" style="border-left: 4px solid var(--hfrs-blue-primary);">
          <div class="hfrs-metric-label">Total Verified Revenue</div>
          <div class="hfrs-metric-value" style="font-size: 1.4rem;">₦<%= parseFloat(metrics.totalRevenue || 0).toLocaleString('en-US', {minimumFractionDigits: 2}) %></div>
          <div class="hfrs-metric-subtext">Confirmed payments</div>
        </div>
      </div>

      <!-- ERS Style Pending Queue Table -->
      <div class="hfrs-card">
        <div class="hfrs-card-header">
          <h2 class="hfrs-card-title">Pending Verification Queue List</h2>
          <span class="hfrs-badge hfrs-badge-pending">Queue: <%= pendingQueue ? pendingQueue.length : 0 %></span>
        </div>

        <div class="hfrs-table-responsive">
          <table class="hfrs-table">
            <thead>
              <tr>
                <th>Order</th>
                <th>App Number</th>
                <th>Student Details</th>
                <th>Faculty & Department</th>
                <th>Payment Status</th>
                <th>Submission Date</th>
                <th>Status</th>
                <th style="text-align: right;">Action</th>
              </tr>
            </thead>
            <tbody>
              <% if (pendingQueue && pendingQueue.length > 0) { %>
                <% pendingQueue.forEach((item, index) => { %>
                  <tr>
                    <td style="font-weight: 600; color: var(--hfrs-text-muted);"><%= index + 1 %></td>
                    <td><strong><%= item.application_number %></strong></td>
                    <td>
                      <div style="font-weight: 600; color: #000000;"><%= item.student_name %></div>
                      <small style="color: var(--hfrs-text-muted);"><%= item.student_email %></small>
                    </td>
                    <td><%= item.faculty %> / <%= item.department %></td>
                    <td>
                      <% if (item.payment_status === 'confirmed') { %>
                        <span class="hfrs-status-text complete">Confirmed</span>
                      <% } else if (item.payment_status === 'pending') { %>
                        <span class="hfrs-status-text pending">Payment Pending</span>
                      <% } else { %>
                        <span class="hfrs-status-text draft">Unpaid</span>
                      <% } %>
                    </td>
                    <td><%= new Date(item.submitted_at).toLocaleDateString() %></td>
                    <td>
                      <span class="hfrs-badge hfrs-badge-pending">PENDING</span>
                    </td>
                    <td style="text-align: right;">
                      <div class="hfrs-row-actions">
                        <a href="/admin/verify/<%= item.registration_id %>" class="hfrs-action-icon-btn" title="Inspect & Verify Record">
                          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                        </a>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="8" style="text-align: center; color: var(--hfrs-text-muted); padding: 2.5rem;">
                    <div style="display: flex; align-items: center; justify-content: center; gap: 0.35rem;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg> No pending registration applications in the queue right now!</div>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <!-- ERS Pagination Bar Footer -->
        <div class="hfrs-pagination-bar">
          <div>
            <span>Items per page: </span>
            <select style="border: 1px solid var(--hfrs-border-color); border-radius: 4px; padding: 0.15rem 0.4rem; font-size: 0.8rem;">
              <option>10</option>
              <option>15</option>
              <option>25</option>
            </select>
          </div>

          <div class="hfrs-pagination-controls">
            <span>1-<%= pendingQueue ? pendingQueue.length : 0 %> of <%= pendingQueue ? pendingQueue.length : 0 %></span>
            <a href="#" class="hfrs-pagination-btn" onclick="return false;">&lt;</a>
            <a href="#" class="hfrs-pagination-btn" onclick="return false;">&gt;</a>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>

<%- include('../partials/footer') %>
