<header class="hfrs-topbar">
  <div class="hfrs-topbar-left">
    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
      <h2 class="hfrs-topbar-greeting">
        Hello, <%= currentUser.name.split(' ')[0] %>! 
        <% if (currentUser.role === 'student') { %>
          <span class="hfrs-topbar-subgreeting">Ready To Complete Your Registration?</span>
        <% } %>
      </h2>
    <% } else { %>
      <h2 class="hfrs-topbar-greeting">
        Welcome to UNICROSS UniRegister <span class="hfrs-topbar-subgreeting">Unified Freshers Portal</span>
      </h2>
    <% } %>
  </div>

  <div class="hfrs-topbar-right">
    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
      <div class="hfrs-icon-cluster" style="position: relative;">
        <!-- Notification Bell Button -->
        <button id="hfrsNotificationToggleBtn" class="hfrs-icon-btn" title="Notifications" aria-label="Notifications" onclick="toggleHfrsDropdown('hfrsNotificationDropdown')">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
          <span class="hfrs-notification-dot"></span>
        </button>

        <!-- Notification Popover Dropdown -->
        <div id="hfrsNotificationDropdown" class="hfrs-dropdown-menu" style="display: none; width: 300px;">
          <div class="hfrs-dropdown-header">
            <strong>System Notifications</strong>
            <span class="hfrs-badge hfrs-badge-approved">3 NEW</span>
          </div>
          <div class="hfrs-dropdown-divider"></div>
          <div class="hfrs-dropdown-item">
            <div style="font-weight: 600; font-size: 0.85rem; color: #000000; display: flex; align-items: center; gap: 0.35rem;"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg> Welcome to UNICROSS UniRegister</div>
            <div style="font-size: 0.75rem; color: var(--hfrs-text-muted);">Your account is active. Complete your bio-data profile & credential uploads.</div>
          </div>
          <div class="hfrs-dropdown-item">
            <div style="font-weight: 600; font-size: 0.85rem; color: #000000; display: flex; align-items: center; gap: 0.35rem;"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg> Acceptance Fee Status</div>
            <div style="font-size: 0.75rem; color: var(--hfrs-text-muted);">Acceptance & Registration Fee is ₦25,000. Simulated payment available in Step 2.</div>
          </div>
          <div class="hfrs-dropdown-item">
            <div style="font-weight: 600; font-size: 0.85rem; color: #000000; display: flex; align-items: center; gap: 0.35rem;"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"></path><circle cx="12" cy="13" r="3"></circle></svg> Passport & Credential Uploads</div>
            <div style="font-size: 0.75rem; color: var(--hfrs-text-muted);">Ensure clear uploads of O-Level results, Admission Letter, and Passport Photo.</div>
          </div>
        </div>

        <!-- Settings Gear Button -->
        <button id="hfrsSettingsToggleBtn" class="hfrs-icon-btn" title="Settings" aria-label="Settings" onclick="openHfrsSettingsModal()">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
        </button>

        <!-- User Profile Avatar Pill -->
        <div id="hfrsProfileToggleBtn" class="hfrs-avatar-pill" title="<%= currentUser.email %>" onclick="toggleHfrsDropdown('hfrsProfileDropdown')" style="cursor: pointer;">
          <div class="hfrs-avatar-circle"><%= currentUser.name.charAt(0).toUpperCase() %></div>
        </div>

        <!-- User Profile Popover Dropdown -->
        <div id="hfrsProfileDropdown" class="hfrs-dropdown-menu" style="display: none; width: 280px; padding: 1.25rem;">
          <div class="hfrs-profile-header">
            <div style="font-weight: 700; font-size: 1rem; color: #000000; word-break: break-word;"><%= currentUser.name %></div>
            <div style="font-size: 0.8rem; color: #64748b; word-break: break-all; margin-top: 0.2rem;"><%= currentUser.email %></div>
            <span class="hfrs-badge hfrs-badge-draft" style="margin-top: 0.5rem; display: inline-block;"><%= currentUser.role.toUpperCase() %> PORTAL</span>
          </div>
          <div class="hfrs-dropdown-divider"></div>
          <% if (currentUser.role === 'student') { %>
            <a href="/student/registration?step=1" class="hfrs-dropdown-link">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
              <span>Edit Bio-Data Profile</span>
            </a>
            <a href="/student/registration?step=3" class="hfrs-dropdown-link">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
              <span>Upload Passport & Credentials</span>
            </a>
            <a href="/student/status" class="hfrs-dropdown-link">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
              <span>Track Registration Status</span>
            </a>
          <% } else { %>
            <a href="/admin/dashboard" class="hfrs-dropdown-link">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
              <span>Verification Queue Dashboard</span>
            </a>
            <a href="/admin/records" class="hfrs-dropdown-link">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
              <span>Student Records Database</span>
            </a>
          <% } %>
          <div class="hfrs-dropdown-divider"></div>
          <form action="/auth/logout" method="POST" style="margin: 0;">
            <button type="submit" class="hfrs-btn hfrs-btn-danger" style="width: 100%; padding: 0.5rem; font-size: 0.85rem; font-weight: 700;">
              Sign Out
            </button>
          </form>
        </div>
      </div>
    <% } else { %>
      <div style="display: flex; gap: 0.5rem;">
        <a href="/auth/login" class="hfrs-btn hfrs-btn-outline">Login</a>
        <a href="/auth/register" class="hfrs-btn hfrs-btn-primary">+ Register Account</a>
      </div>
    <% } %>
  </div>
</header>

<!-- Portal Preferences Settings Modal -->
<div id="hfrsSettingsModal" class="hfrs-modal-overlay" style="display: none;">
  <div class="hfrs-modal-card">
    <div class="hfrs-modal-header">
      <h3 style="font-size: 1.15rem; font-weight: 700; color: #000000; margin: 0; display: flex; align-items: center; gap: 0.35rem;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg> Portal Settings & Preferences</h3>
      <button class="hfrs-modal-close" onclick="closeHfrsSettingsModal()">&times;</button>
    </div>
    <div class="hfrs-modal-body">
      <div class="hfrs-form-group mb-3">
        <label class="hfrs-label">Notification Preference</label>
        <div style="display: flex; align-items: center; justify-content: space-between; padding: 0.65rem 0.85rem; border: 1px solid var(--hfrs-border-color); border-radius: 6px;">
          <span>Email & Portal Registration Alerts</span>
          <input type="checkbox" checked style="width: 18px; height: 18px;">
        </div>
      </div>

      <div class="hfrs-form-group mb-3">
        <label class="hfrs-label">System Contrast Mode</label>
        <div style="display: flex; align-items: center; justify-content: space-between; padding: 0.65rem 0.85rem; border: 1px solid var(--hfrs-border-color); border-radius: 6px;">
          <span>High-Contrast Solid Text</span>
          <input type="checkbox" checked style="width: 18px; height: 18px;">
        </div>
      </div>

      <div class="hfrs-form-group mb-4">
        <label class="hfrs-label">Security & Session</label>
        <div style="padding: 0.65rem 0.85rem; border: 1px solid var(--hfrs-border-color); border-radius: 6px;">
          <div style="font-size: 0.85rem; font-weight: 600;">Active Password Hash Protection</div>
          <small style="color: var(--hfrs-text-muted);">Encrypted via bcryptjs with 10 salt rounds.</small>
        </div>
      </div>

      <div style="text-align: right;">
        <button class="hfrs-btn hfrs-btn-primary" onclick="closeHfrsSettingsModal()">Save Preferences</button>
      </div>
    </div>
  </div>
</div>

<script>
  function toggleHfrsDropdown(id) {
    const el = document.getElementById(id);
    const all = ['hfrsNotificationDropdown', 'hfrsProfileDropdown'];
    all.forEach(otherId => {
      if (otherId !== id) {
        const otherEl = document.getElementById(otherId);
        if (otherEl) otherEl.style.display = 'none';
      }
    });
    if (el) {
      el.style.display = (el.style.display === 'none' || !el.style.display) ? 'block' : 'none';
    }
  }

  function openHfrsSettingsModal() {
    const modal = document.getElementById('hfrsSettingsModal');
    if (modal) modal.style.display = 'flex';
  }

  function closeHfrsSettingsModal() {
    const modal = document.getElementById('hfrsSettingsModal');
    if (modal) modal.style.display = 'none';
  }

  // Close dropdowns on outside click
  document.addEventListener('click', function(e) {
    const cluster = document.querySelector('.hfrs-icon-cluster');
    if (cluster && !cluster.contains(e.target)) {
      const dropdowns = ['hfrsNotificationDropdown', 'hfrsProfileDropdown'];
      dropdowns.forEach(id => {
        const el = document.getElementById(id);
        if (el) el.style.display = 'none';
      });
    }
  });
</script>
