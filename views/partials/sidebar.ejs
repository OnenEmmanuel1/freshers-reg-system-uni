<aside class="hfrs-sidebar">
  <div class="hfrs-sidebar-brand">
    <div class="hfrs-logo-badge">
      <div class="hfrs-logo-circle primary"></div>
      <div class="hfrs-logo-circle secondary"></div>
    </div>
    <span class="hfrs-brand-text">UniRegister</span>
  </div>

  <% if (typeof currentUser !== 'undefined' && currentUser) { %>
    <% if (currentUser.role === 'student') { %>
      <div class="hfrs-sidebar-group">
        <div class="hfrs-sidebar-section-title">Registration Information</div>
        <div class="hfrs-sidebar-divider"></div>
        <a href="/student/dashboard" class="hfrs-nav-item <%= activePage === 'dashboard' ? 'active' : '' %>">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
          <span>Dashboard</span>
        </a>
        <a href="/student/registration" class="hfrs-nav-item <%= activePage === 'registration' ? 'active' : '' %>">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
          <span>Registration Form</span>
        </a>
        <a href="/student/status" class="hfrs-nav-item <%= activePage === 'status' ? 'active' : '' %>">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          <span>Tracking Status</span>
        </a>
      </div>

      <div class="hfrs-sidebar-group mt-4">
        <div class="hfrs-sidebar-section-title">My Account</div>
        <div class="hfrs-sidebar-divider"></div>
        <div class="hfrs-nav-item readonly-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          <span><%= currentUser.name.split(' ')[0] %></span>
        </div>
        <form action="/api/auth/logout" method="POST" style="margin: 0;">
          <button type="submit" class="hfrs-nav-item btn-as-link" style="width: 100%; border: none; background: none; text-align: left; cursor: pointer;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
            <span>Sign out</span>
          </button>
        </form>
      </div>

    <% } else if (currentUser.role === 'admin') { %>
      <div class="hfrs-sidebar-group">
        <div class="hfrs-sidebar-section-title">Administration</div>
        <div class="hfrs-sidebar-divider"></div>
        <a href="/admin/dashboard" class="hfrs-nav-item <%= activePage === 'admin-dashboard' ? 'active' : '' %>">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
          <span>Dashboard Queue</span>
        </a>
        <a href="/admin/records" class="hfrs-nav-item <%= activePage === 'admin-records' ? 'active' : '' %>">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
          <span>Student Records</span>
        </a>
        <a href="/admin/reports" class="hfrs-nav-item <%= activePage === 'admin-reports' ? 'active' : '' %>">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
          <span>Analytics & Reports</span>
        </a>
      </div>

      <div class="hfrs-sidebar-group mt-4">
        <div class="hfrs-sidebar-section-title">My Account</div>
        <div class="hfrs-sidebar-divider"></div>
        <div class="hfrs-nav-item readonly-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          <span>Administrator</span>
        </div>
        <form action="/api/auth/logout" method="POST" style="margin: 0;">
          <button type="submit" class="hfrs-nav-item btn-as-link" style="width: 100%; border: none; background: none; text-align: left; cursor: pointer;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
            <span>Sign out</span>
          </button>
        </form>
      </div>
    <% } %>
  <% } %>
</aside>
